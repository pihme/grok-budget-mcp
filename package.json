{
  "name": "grok-budget-mcp",
  "version": "1.0.0",
  "description": "A small local MCP server that tells a Grok Build agent how much of its weekly usage pool is left, the same figure as /usage. Read-only, unofficial endpoint.",
  "license": "MIT",
  "author": "pihme (https://github.com/pihme)",
  "type": "module",
  "bin": {
    "grok-budget-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pihme/grok-budget-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "grok",
    "grok-build",
    "supergrok",
    "usage"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
